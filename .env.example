# Copy to .env (which git ignores) and replace every value. These are placeholders, not credentials.

# PostgreSQL: the table owner that Flyway migrates as, and the unprivileged role the application uses.
BILLING_MIGRATION_DB_USER=billing
BILLING_MIGRATION_DB_PASSWORD=replace-me
BILLING_DB_USER=billing_app
BILLING_DB_PASSWORD=replace-me-too

# Keycloak: the console administrator, and the secret of the billing-admin service-account client
# that Billing uses to create identities.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-me
BILLING_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me
BILLING_KEYCLOAK_URL=http://localhost:8081
BILLING_OIDC_ISSUER_URI=http://localhost:8081/realms/billing

# Master key for secrets stored in the database (webhook signing secrets): base64 of 32 random bytes.
# Generate with `openssl rand -base64 32`. Losing it makes stored secrets unreadable; changing it needs a re-encryption.
BILLING_SECRETS_MASTER_KEY=replace-me
# Development only: lets webhooks go to http and loopback or private addresses (a local receiver).
BILLING_WEBHOOKS_ALLOW_INSECURE_TARGETS=true

# Optional: creates the first Platform administrator on start (you set a new password at first login).
BILLING_BOOTSTRAP_ADMIN_EMAIL=
BILLING_BOOTSTRAP_ADMIN_TEMPORARY_PASSWORD=

# Sample Tenant System: its own database and the Billing credential it calls with.
SAMPLE_TENANT_DB_PASSWORD=tenant
SAMPLE_TENANT_BILLING_API_KEY=
SAMPLE_TENANT_BILLING_SYSTEM_ID=
SAMPLE_TENANT_WEBHOOK_SECRET=
SAMPLE_TENANT_BOOTSTRAP_ENABLED=false
SAMPLE_TENANT_BOOTSTRAP_ADMIN_TOKEN=

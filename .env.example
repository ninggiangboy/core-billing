# Copy to .env (which git ignores) and replace every value. These are placeholders, not credentials.

# PostgreSQL: the table owner that Flyway migrates as, and the unprivileged role the application uses.
BILLING_MIGRATION_DB_USER=corebilling
BILLING_MIGRATION_DB_PASSWORD=replace-me
BILLING_DB_USER=corebilling_app
BILLING_DB_PASSWORD=replace-me-too

# Keycloak: the console administrator, and the secret of the billing-admin service-account client
# that Billing uses to create identities.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-me
BILLING_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me
BILLING_KEYCLOAK_URL=http://localhost:8081
BILLING_OIDC_ISSUER_URI=http://localhost:8081/realms/corebilling

# Optional: creates the first Platform administrator on start (you set a new password at first login).
BILLING_BOOTSTRAP_ADMIN_EMAIL=
BILLING_BOOTSTRAP_ADMIN_TEMPORARY_PASSWORD=

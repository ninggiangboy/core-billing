{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corebilling.io/events/payment.failed.schema.json",
  "title": "Payment failed",
  "description": "A wallet top-up ended without money: Stripe could not collect it, or the customer's attempts were all declined. The wallet was not changed. This schema describes the `data` member of the delivered document; the envelope (id, type, tenantId, occurredAt, data) is described in README.md.",
  "type": "object",
  "required": [
    "paymentId",
    "walletId",
    "customerId",
    "amount"
  ],
  "additionalProperties": false,
  "properties": {
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "walletId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "$ref": "#/$defs/money"
    },
    "reason": {
      "type": "string"
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units (cents, dong) of one ISO 4217 currency.",
      "required": [
        "minorUnits",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minorUnits": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}

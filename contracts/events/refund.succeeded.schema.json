{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corebilling.io/events/refund.succeeded.schema.json",
  "title": "Refund succeeded",
  "description": "Money was sent back to the customer's card through Stripe and the wallet was debited for it. This schema describes the `data` member of the delivered document; the envelope (id, type, tenantId, occurredAt, data) is described in README.md.",
  "type": "object",
  "required": [
    "refundId",
    "paymentId",
    "walletId",
    "amount",
    "ledgerEntryId"
  ],
  "additionalProperties": false,
  "properties": {
    "refundId": {
      "type": "string",
      "format": "uuid"
    },
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "walletId": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "$ref": "#/$defs/money"
    },
    "ledgerEntryId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units (cents, dong) of one ISO 4217 currency.",
      "required": [
        "minorUnits",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minorUnits": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}

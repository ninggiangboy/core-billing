{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billing.io/events/reservation.created.schema.json",
  "title": "Reservation created",
  "description": "A budget was held on a wallet before a resource is executed. This schema describes the `data` member of the delivered document; the envelope (id, type, tenantId, occurredAt, data) is described in README.md.",
  "type": "object",
  "required": [
    "reservationId",
    "walletId",
    "amount",
    "expiresAt",
    "reference"
  ],
  "additionalProperties": false,
  "properties": {
    "reservationId": {
      "type": "string",
      "format": "uuid"
    },
    "walletId": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "$ref": "#/$defs/money"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "reference": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units (cents, dong) of one ISO 4217 currency.",
      "required": [
        "minorUnits",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minorUnits": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}

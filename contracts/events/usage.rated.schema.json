{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billing.io/events/usage.rated.schema.json",
  "title": "Usage rated",
  "description": "A customer's usage for a period was priced under a specific plan version and accounted for: charged to the wallet, or rated to nothing. A rating whose charge failed announces charge.failed instead and leaves the usage free to rate again. This schema describes the `data` member of the delivered document; the envelope (id, type, tenantId, occurredAt, data) is described in README.md.",
  "type": "object",
  "required": [
    "ratingId",
    "customerId",
    "walletId",
    "planId",
    "planVersion",
    "status",
    "amount",
    "chargeId",
    "usageCount",
    "periodStart",
    "periodEnd"
  ],
  "additionalProperties": false,
  "properties": {
    "ratingId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "walletId": {
      "type": "string",
      "format": "uuid"
    },
    "planId": {
      "type": "string",
      "format": "uuid"
    },
    "planVersion": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CHARGED",
        "NO_CHARGE"
      ]
    },
    "amount": {
      "$ref": "#/$defs/money"
    },
    "chargeId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "usageCount": {
      "type": "integer",
      "minimum": 1
    },
    "periodStart": {
      "type": "string",
      "format": "date-time"
    },
    "periodEnd": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units (cents, dong) of one ISO 4217 currency.",
      "required": [
        "minorUnits",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minorUnits": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
